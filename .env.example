# SOLARIS configuration. Copy to `.env` and fill in.
# `.env` is gitignored -- never commit real credentials.

# ---------------------------------------------------------------------------
# Earth Engine (required)
# ---------------------------------------------------------------------------
# The GCP project used for all Earth Engine calls. Must have the Earth Engine
# API enabled AND be registered (noncommercial or commercial).
# This is server-side only -- it is deliberately NOT accepted from requests.
GEE_PROJECT_ID=pv-mapping-india

# Credential resolution order (first match wins):
#   1. GEE_SA_JSON      -- whole service-account key inline (non-GCP hosts)
#   2. GEE_SA_KEY_FILE  -- path to a service-account key file
#   3. Application Default Credentials -- keyless; Cloud Run, GCE, Cloud Build,
#      Workload Identity Federation. This is what production uses.
#   4. local `earthengine authenticate` credentials (dev)
#
# Leave all of these unset for local development after running:
#   earthengine authenticate
#
# GEE_SERVICE_ACCOUNT=solaris-api@your-project.iam.gserviceaccount.com
# GEE_SA_KEY_FILE=/absolute/path/to/key.json
# GEE_SA_JSON=

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Comma-separated allowed origins. The UI is served same-origin, so this only
# matters for local dev and any separately-hosted frontend.
SOLARIS_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Computations a guest may run per session before being asked to sign in.
# Cached results do not count. Comparing several roofs is the primary task, so
# this needs to be comfortably above the number of sites a visitor will look at.
SOLARIS_GUEST_COMPUTATION_ALLOWANCE=10
