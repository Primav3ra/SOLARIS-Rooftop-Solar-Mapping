# Node / frontend
node_modules/
.vite/
*.tsbuildinfo

# Built frontend bundles are generated, not source (see docs/architecture.md)
# The built frontend. Generated by `npm --prefix frontend/site run build`,
# which Vite writes straight into the package so the StaticFiles mount finds
# it. Not committed: the chunk filenames are content-hashed, so every rebuild
# would churn ~2 MB of generated files and bury the real diff. The Docker
# image builds it in its own stage; see docs/contributing.md for local use.
src/solaris/api/static/

# Secrets and local config
.env
.env.*
!.env.example
*-service-account.json
*credentials*.json
gee-key*.json

# ML artifacts (versioned in GCS; see models/MANIFEST.json)
models/**/*.joblib
models/**/*.pkl
models/**/*.txt.model
models/**/data/

# Eval outputs are CI artifacts, except the reports that are the project's
# evidence. Those are committed, and the frontend imports them at build time so
# the Validation and Models pages cannot drift from them -- which means an
# ignored report is a broken build, not a missing file. Add any new committed
# report here and to frontend/site/src/data/reports.js together.
/reports/
evals/reports/*
!evals/reports/latest.md
!evals/reports/latest.json
!evals/reports/soiling.md
!evals/reports/soiling.json
!evals/reports/track_b_profile.md
!evals/reports/track_b_profile.json

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# Scratch
scratch/
tmp/
*.log
